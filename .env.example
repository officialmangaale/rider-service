# Rider Service Environment Variables
# Must match the user-service database and JWT secret

PORT=8084
DATABASE_URL=postgres://postgres:password@localhost:5432/fooddelivery?sslmode=disable
JWT_SECRET=your_shared_jwt_secret_from_user_service

# Device push (FCM HTTP v1) for delivery offers. Optional: without it offers
# still reach riders over the socket and the app's polling, but a rider whose
# app is closed or backgrounded is not woken. See docs/offer-push-notifications.md.
# A Google service-account key for the Firebase project of the RIDER app
# (google-services.json project_id), as raw JSON or base64 of it:
FCM_SERVICE_ACCOUNT_JSON=
# ...or a path to the key file (GOOGLE_APPLICATION_CREDENTIALS also works):
FCM_SERVICE_ACCOUNT_FILE=
# Optional; defaults to the service account's project_id:
FCM_PROJECT_ID=

# Google Routes (server-side). Route calculations are informational only: they
# never feed delivery fees, commission, rider radius, payouts or dispatch.
# Use a SERVER key restricted to the Routes API and to this server's egress IP.
# Never place it in an app, local.properties or AndroidManifest.xml.
GOOGLE_ROUTES_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_MAPS_TIMEOUT_MS=5000
GOOGLE_MAPS_MAX_RETRIES=1
# false = DRIVE + TRAFFIC_UNAWARE (Routes Essentials, the default). true bills
# as Routes Pro; enable only after reviewing measured usage.
GOOGLE_ROUTES_TRAFFIC_ENABLED=false
# Provider-level response cache. Keep <=300 seconds.
GOOGLE_ROUTES_CACHE_TTL_SECONDS=60

# Per-order route reuse. One route per order/rider/destination is reused for
# every rider and customer poll; a provider call is made only when an order
# enters a new delivery phase, has no route, the rider leaves the route, or the
# route reaches the hold limit. In-memory only; never persisted.
GOOGLE_ROUTES_REUSE_MAX_AGE_SECONDS=900
GOOGLE_ROUTES_OFF_ROUTE_METERS=100
GOOGLE_ROUTES_OFF_ROUTE_SAMPLES=2
GOOGLE_ROUTES_DEVIATION_COOLDOWN_SECONDS=45
GOOGLE_ROUTES_FAILURE_COOLDOWN_SECONDS=30
GOOGLE_ROUTES_MIN_INTERVAL_SECONDS=5

# Request budgets (in-process). A refused refresh never serves a wrong route.
GOOGLE_ROUTES_MAX_CALLS_PER_ORDER=8
GOOGLE_ROUTES_MAX_CALLS_PER_MINUTE=30
GOOGLE_ROUTES_DAILY_BUDGET=2000
GOOGLE_ROUTES_MAX_CONCURRENCY=4

# Phase 6 customer live tracking bridge. Off by default; when enabled,
# rider-service sends lightweight rider-location deltas to restaurant-service
# after the canonical location write succeeds.
RESTAURANT_SERVICE_INTERNAL_BASE_URL=
INTERNAL_SERVICE_TOKEN=
CUSTOMER_LIVE_TRACKING_ENABLED=false
