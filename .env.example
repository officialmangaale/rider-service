# Rider Service Environment Variables
# Must match the user-service database and JWT secret

PORT=8084
DATABASE_URL=postgres://postgres:password@localhost:5432/fooddelivery?sslmode=disable
JWT_SECRET=your_shared_jwt_secret_from_user_service

# Device push (FCM HTTP v1) for delivery offers. Optional: without it offers
# still reach riders over the socket and the app's polling, but a rider whose
# app is closed or backgrounded is not woken. See docs/offer-push-notifications.md.
# A Google service-account key for the Firebase project of the RIDER app
# (google-services.json project_id), as raw JSON or base64 of it:
FCM_SERVICE_ACCOUNT_JSON=
# ...or a path to the key file (GOOGLE_APPLICATION_CREDENTIALS also works):
FCM_SERVICE_ACCOUNT_FILE=
# Optional; defaults to the service account's project_id:
FCM_PROJECT_ID=
